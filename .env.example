# ==========================================
# Google Gemini & Application Configuration
# ==========================================

# Your Google Gemini API Key from Google AI Studio
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Recommended models: gemini-3.8-flash, gemini-3.5-flash, gemini-3.1-pro-preview
GEMINI_MODEL="gemini-3.8-flash"

# Port server lokal Express
PORT=3000

